# Este é um arquivo de exemplo. Copie este arquivo para .env e preencha com seus valores reais.

# Credenciais da AWS - Substitua pelos seus valores
AWS_ACCESS_KEY_ID=SUA_ACCESS_KEY_AQUI
AWS_SECRET_ACCESS_KEY=SUA_CHAVE_SECRETA_AQUI
AWS_REGION=sua-regiao-aws # ex: us-east-1

# E-mail de remetente verificado no AWS SES
EMAIL_USERNAME=seu-email-verificado@exemplo.com

# Porta da aplicação
SERVER_PORT=8081